{
  "name": "@lemuai/react",
  "version": "1.1.0",
  "description": "Lemu tracking for React and Next.js: provider, hooks and page tracking.",
  "license": "MIT",
  "author": "LemuAI",
  "homepage": "https://docs.lemuai.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LemuAI/lemu-sdks.git",
    "directory": "js/packages/react"
  },
  "keywords": ["lemu", "analytics", "react", "nextjs", "tracking"],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "lint": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@lemuai/analytics": "^1.1.0"
  },
  "peerDependencies": {
    "react": ">=17"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "jsdom": "^26.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}

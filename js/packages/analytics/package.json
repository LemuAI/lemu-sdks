{
  "name": "@lemuai/analytics",
  "version": "1.1.0",
  "description": "Lemu tracking for websites and JavaScript apps: events, purchases, identify, consent.",
  "license": "MIT",
  "author": "LemuAI",
  "homepage": "https://docs.lemuai.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LemuAI/lemu-sdks.git",
    "directory": "js/packages/analytics"
  },
  "keywords": ["lemu", "analytics", "tracking", "pixel", "conversions", "meta pixel"],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/lemu.js",
  "jsdelivr": "./dist/lemu.js",
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    },
    "./core": {
      "import": { "types": "./dist/core.d.ts", "default": "./dist/core.js" },
      "require": { "types": "./dist/core.d.cts", "default": "./dist/core.cjs" }
    },
    "./lemu.js": "./dist/lemu.js",
    "./package.json": "./package.json"
  },
  "sideEffects": ["./dist/lemu.js"],
  "files": ["dist", "core", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "lint": "tsc --noEmit -p tsconfig.json",
    "size": "node scripts/size.mjs"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "jsdom": "^26.1.0"
  }
}
